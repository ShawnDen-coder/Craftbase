{
  "name": "craftbase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal UI/UX foundation for React, Vue, and Tailwind CSS.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "verify": "pnpm lint && pnpm check && pnpm check:upstream && pnpm test && pnpm build:site",
    "prepare": "husky",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev": "vite --host 127.0.0.1",
    "build:site": "tsc --noEmit && vite build",
    "check:upstream": "node scripts/sync-shadcn.mjs --check",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "husky": "9.1.7",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@11.0.9",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "1.61.0",
    "next-themes": "^0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.14.8",
    "recharts": "3.8.0",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  }
}

{
  "name": "craftbase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal UI/UX foundation for React, Vue, and Tailwind CSS.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "verify": "pnpm lint && pnpm check && pnpm test && pnpm build:site",
    "prepare": "husky",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev": "vite --host 127.0.0.1",
    "build:site": "tsc --noEmit && vite build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "husky": "9.1.7",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@11.0.9",
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tabbable": "6.5.0",
    "tailwind-merge": "3.7.0"
  }
}

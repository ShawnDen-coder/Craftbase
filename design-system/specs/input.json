{
  "id": "input",
  "status": "historical",
  "description": "输入单行文本",
  "avoid": "富文本、多行编辑",
  "implementations": {
    "react": "upstream",
    "vue": "not-in-scope"
  },
  "props": {
    "size": ["default", "small"],
    "disabled": "boolean",
    "invalid": "boolean",
    "readOnly": "boolean",
    "nativeSize": ["mini", "small", "medium", "large", "xl"]
  },
  "states": [
    "default",
    "hover",
    "focus-visible",
    "disabled",
    "invalid",
    "readonly"
  ],
  "appearance": ["light", "dark"],
  "density": ["comfortable", "compact"],
  "behavior": [
    "可见 label 与 input id 关联，错误/说明通过 aria-describedby 关联。",
